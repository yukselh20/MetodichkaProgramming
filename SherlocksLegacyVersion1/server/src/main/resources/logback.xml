<!-- server/src/main/resources/logback.xml -->
<configuration>

    <!-- This defines an "appender" that writes log messages to the console -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- This pattern defines the format of each log message -->
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- This sets the logging level for specific project code.
         Setting it to DEBUG will show INFO, WARN, ERROR, and DEBUG messages. -->
    <logger name="server" level="DEBUG"/>

    <!-- This is the "root" logger. It applies to all other code (like libraries).
         Setting it to INFO is a good practice to reduce noise. -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

</configuration>